# MCP HTTP server
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
LOG_LEVEL=info

# MCP Server authentication - comma-separated bearer tokens
MCP_AUTH_TOKENS=
MCP_INSPECT_TOKEN=

# Integrated ADVBOX API
ADVBOX_API_URL=https://app.advbox.com.br/api/v1
# Optional fallback for local/development use. Production users should send X-ADVBOX-API-KEY.
ADVBOX_TOKEN=
