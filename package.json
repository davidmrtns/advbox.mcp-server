{
  "name": "advbox.mcp-server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "tsc --noEmit",
    "build:docker": "tsc --outDir dist --sourceMap false --declaration false --declarationMap false",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "inspect": "concurrently -k -n server,inspector \"npm:start\" \"npx @modelcontextprotocol/inspector --transport http --server-url http://127.0.0.1:3000/mcp\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^2.16.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
